# Google API Key for Gemini
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Gemini Model Name (optional)
# Available models: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash-exp
# Default: gemini-1.5-flash
GEMINI_MODEL=gemini-1.5-flash

# Database URL for PostgreSQL persistence (optional)
# Default: postgresql://localhost/langgraph_chats
# For development: postgresql://username:password@localhost:5432/dbname
# For production: use your hosted PostgreSQL URL
DATABASE_URL=postgresql://rohit.jain@localhost:5432/langgraph_chats

# Logging Level (optional)
# Available levels: DEBUG, INFO, WARNING, ERROR
# Default: DEBUG (for development), use INFO for production
LOG_LEVEL=DEBUG